# Your client's live domain (no trailing slash) — used for SEO/canonical URLs
NEXT_PUBLIC_SITE_URL=https://squarekvacations.com

# The domain KEY the NGF portal stored this site's content under. Keep this
# separate from NEXT_PUBLIC_SITE_URL so changing the public domain never
# breaks content lookup. For Square K, content was saved under the Vercel URL:
NGF_CONTENT_DOMAIN=square-k-vacations.vercel.app

# NGF app URL — only change if using a custom NGF deployment
NGF_APP_URL=https://app.ngfsystems.com

# Must match WEBSITE_REVALIDATION_SECRET in NGF Systems app Vercel env vars
WEBSITE_REVALIDATION_SECRET=your-secret-here

# --- Email (form submissions via Resend) ---
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here

# Verified sender. Until squarekvacations.com is verified in Resend you can use
# "Square K Vacations <onboarding@resend.dev>" for testing.
EMAIL_FROM=Square K Vacations <bookings@squarekvacations.com>

# Who receives form submissions. Comma-separate to send to MULTIPLE emails.
NOTIFY_EMAILS=tyler@squarekvacations.com
# Optional per-form overrides (fall back to NOTIFY_EMAILS if unset):
# BOOKING_NOTIFY_EMAILS=tyler@squarekvacations.com, bookings@squarekvacations.com
# CONTACT_NOTIFY_EMAILS=tyler@squarekvacations.com
